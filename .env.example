# ─── AlgoX Environment Variables ──────────────────────────
# Copy to .env and fill in your values

# Flask secret key (change this!)
SECRET_KEY=algox-secret-key-2024-change-me

# Flask debug mode (true/false)
FLASK_DEBUG=true

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/algox

# Server port (default 3000)
PORT=3000
HOST=0.0.0.0

# NIFTY lot size (default 65 per user spec)
LOT_QTY=65